{
  "name": "alnv/prosearch-indexer-contao-adapter-bundle",
  "type": "contao-bundle",
  "license": "proprietary",
  "description": "Contao Search Pro || Elasticsearch - Opensearch",
  "keywords": ["contao", "elasticsearch", "opensearch"],
  "authors": [
    {
      "name": "SINEOS GmbH",
      "homepage": "https://www.sineos.de",
      "role": "Support"
    },
    {
      "name": "Alexander Naumov",
      "homepage": "https://alexandernaumov.de",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Alnv\\ProSearchIndexerContaoAdapterBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Alnv\\ProSearchIndexerContaoAdapterBundle\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "~5.0",
    "menatwork/contao-multicolumnwizard-bundle": "^3.6",
    "smalot/pdfparser": "^2.12",
    "symfony/cache-contracts": "^2.5 || ^3.0",
    "symfony/http-client": "^6.4 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "preferred-install": "dist"
  },
  "extra": {
    "contao-manager-plugin": "Alnv\\ProSearchIndexerContaoAdapterBundle\\ContaoManager\\Plugin"
  }
}
