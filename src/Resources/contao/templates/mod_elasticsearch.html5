<?php $this->extend('block_unsearchable'); ?>
<?php $this->block('content'); ?>
<div id="<?= $this->elementId ?>" class="elasticsearch-container ps-search ps-search--panel<?= $this->panelOpen ? ' results_open' : '' ?>" data-prosearch="<?= $this->config ?>">
  <div class="elasticsearch-container-inside">
    <form id="<?= $this->formId ?>" class="ps-search__form" action="<?= $this->action ?>" method="post" role="search" aria-label="<?= $this->formLabel ?>">
      <input type="hidden" name="FORM_SUBMIT" value="prosearch_search">
      <input type="hidden" name="REQUEST_TOKEN" value="<?= $this->requestToken ?>">
      <div class="elasticsearch-search-panel">
        <div class="elasticsearch-input">
          <label for="<?= $this->inputId ?>"<?php if (!$this->inputLabelVisible): ?> class="invisible"<?php endif; ?>><?= $this->inputLabel ?></label>
          <input id="<?= $this->inputId ?>" class="ps-search__input" type="search" name="keywords" value="<?= $this->keywordsValue ?>"<?php if ($this->keywordLabel): ?> placeholder="<?= $this->keywordLabel ?>"<?php endif; ?> autocomplete="off" spellcheck="false" autocapitalize="off" enterkeyhint="search" aria-describedby="<?= $this->hintId ?>"<?php if ($this->showResults): ?> aria-controls="<?= $this->panelId ?>"<?php endif; ?>>
          <button type="submit" class="elasticsearch-input-button">
            <?php if ($this->searchIcon): ?><img src="<?= $this->searchIcon ?>" alt="" class="button-search-icon" data-ps-icon><?php endif; ?>
            <?php if ($this->loadingIcon): ?><img src="<?= $this->loadingIcon ?>" alt="" class="button-loading-icon" data-ps-loading hidden><?php endif; ?>
            <span<?php if (!$this->buttonLabelVisible): ?> class="invisible"<?php endif; ?>><?= $this->buttonLabel ?></span>
          </button>
        </div>
        <p id="<?= $this->hintId ?>" class="ps-search__hint invisible"><?= $this->hint ?></p>
      </div>
    </form>

    <p id="<?= $this->statusId ?>" class="ps-search__status invisible" role="status" aria-live="polite" aria-atomic="true" data-ps-status></p>

    <?php if ($this->showResults): ?>
      <div id="<?= $this->panelId ?>" class="elasticsearch-results-panel" role="region" aria-label="<?= $this->resultsLabel ?>" data-ps-panel<?php if (!$this->panelOpen): ?> hidden<?php endif; ?>>
        <div class="close-results">
          <button type="button" class="close button" data-ps-close><span class="invisible"><?= $this->closeLabel ?></span></button>
        </div>
        <div class="ps-search__content" data-ps-content><?= $this->panel ?></div>
      </div>
    <?php endif; ?>
  </div>
</div>
<?php $this->endblock(); ?>
